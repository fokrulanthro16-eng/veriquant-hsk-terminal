# ==============================================================================
# VeriQuant HSK Quant Terminal - Environment Configuration Template
# HSK Chain Horizon Hackathon (Mumbai Edition)
# ==============================================================================

# Local Execution Port
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# HSK Chain Network Telemetry (EVM JSON-RPC)
# ------------------------------------------------------------------------------
# HSK Mainnet RPC (Primary Production Target)
HSK_MAINNET_RPC_URL=https://mainnet.hsk.xyz
CHAIN_ID=177

# HSK Testnet RPC (Staging / Verification)
HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz
TESTNET_CHAIN_ID=133

# Subscan Explorer URL
EXPLORER_URL=https://hashkey.subscan.io

# ------------------------------------------------------------------------------
# Institutional Vault & AI Session Operator Parameters
# ------------------------------------------------------------------------------
# Deployed Vault Contract Address (on HSK Chain)
VAULT_CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# Delegated AI Session Operator (Scoped Signer Address)
AI_SESSION_OPERATOR_ADDRESS=0x3A5a0b73c4d4400E78964C1d9534720eB1E3279c

# Vault Owner (Institutional Custodian Address)
VAULT_OWNER_ADDRESS=0xa508dD875f10C33C52a8abb20E16fc040820762F

# ------------------------------------------------------------------------------
# Chainlink CCIP Directory & Router
# ------------------------------------------------------------------------------
CCIP_ROUTER_ADDRESS=0x40954b9f30b9d997f3747f48039a67a845942426
ETHEREUM_LANE_SELECTOR=5009297550715157269
ARBITRUM_LANE_SELECTOR=4949039107694359620
BASE_LANE_SELECTOR=15971525489660198786

# ------------------------------------------------------------------------------
# HSP (HashKey Settlement Protocol) Agent-to-Agent Stream
# ------------------------------------------------------------------------------
HSP_MICRO_FEE_BPS=1000 # 10.0% of verified net trading profit
HSP_LOSS_PENALTY_ENABLED=true
